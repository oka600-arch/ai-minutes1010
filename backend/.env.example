# ===== Supabase =====
# Project Settings > API の URL と service_role（secret）キー。絶対にフロントエンドに置かないこと
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== 文字起こし（faster-whisper。サーバー内で動くので無料・キー不要）=====
# small：標準（速い） / medium：より正確（約2〜3倍遅い） / large-v3：最も正確（とても遅い）
WHISPER_MODEL=small
# NVIDIA GPU がある場合は cuda と float16 にすると大幅に速くなる
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0
# 1 にすると速くなるが、精度が少し下がる
WHISPER_BEAM_SIZE=5

# ===== AI解析（要約・決定事項・TODO）=====
# gemini：Google Gemini API（無料枠あり） / ollama：社内 PC などで動かすローカル AI
ANALYSIS_PROVIDER=gemini
# https://aistudio.google.com/apikey で発行（無料）。無料枠では送った内容が Google の改善に使われることがある
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANALYSIS_PROVIDER=ollama のときだけ使う
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== Dropbox（ユーザーごとの OAuth）=====
# https://www.dropbox.com/developers/apps で作成したアプリの App key / App secret
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Dropbox アプリの Redirect URIs にも同じ値を登録する
DROPBOX_REDIRECT_URI=http://localhost:8000/api/dropbox/callback
DROPBOX_ROOT_FOLDER=/AI議事録

# Dropbox トークン暗号化キー。次のコマンドで生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ===== フロントエンド =====
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
