# ===== Supabase =====
# Project Settings > API の URL と service_role（secret）キー。絶対にフロントエンドに置かないこと
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1

# ===== Dropbox（ユーザーごとの OAuth）=====
# https://www.dropbox.com/developers/apps で作成したアプリの App key / App secret
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Dropbox アプリの Redirect URIs にも同じ値を登録する
DROPBOX_REDIRECT_URI=http://localhost:8000/api/dropbox/callback
DROPBOX_ROOT_FOLDER=/AI議事録

# Dropbox トークン暗号化キー。次のコマンドで生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ===== フロントエンド =====
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
